{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "AERORE_BUILD_GUI": "ON",
        "AERORE_BUILD_PYTHON": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/windows-x64",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 (headless)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x64",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "AERORE_BUILD_GUI": "OFF",
        "AERORE_BUILD_PYTHON": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/linux-x64",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-release", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "linux-x64-release", "configurePreset": "linux-x64" }
  ],
  "testPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64",
      "output": { "outputOnFailure": true }
    }
  ]
}

