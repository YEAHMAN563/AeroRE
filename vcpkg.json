{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "aerore",
  "version-semver": "0.3.0",
  "description": "Native Windows x86/x64 static and dynamic analysis workbench",
  "license": "MIT",
  "builtin-baseline": "0699a19d0c6386247ce50d4dedbb8217d484d536",
  "dependencies": [
    {
      "name": "imgui",
      "features": ["docking-experimental", "dx11-binding", "win32-binding"],
      "platform": "windows"
    },
    "liblzma",
    "sqlite3",
    "zydis"
  ],
  "features": {
    "python": {
      "description": "Build the optional pybind11 automation module",
      "dependencies": ["pybind11"]
    }
  }
}

